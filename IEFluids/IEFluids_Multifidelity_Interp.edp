///////////////////////////////////////////////////////////////////////////////

// Fase OFFLINE del método multifidelity con los datos de IEFluids.
// Greedy sobre el número de Reynolds guiado por el estimador espectral de Kolmogorov (K41):
// la solución reducida se construye con coeficientes LF sobre la base POD HF, y su espectro 3D
// (calculado por muestreo en rejilla + DFT, ver fourier3D_FFT.idp) se compara con la ley k^(-5/3).

load "msh3"
load "gmsh"
load "iovtk"
load "lapack"

verbosity = 0;
int[int] fforder=[1,1,1,1];

load "PETSc"

// Paralelo
macro dimension() 3 //EOM
bool PETScON = true;

include "macro_ddm.idp"


// Normas y productos escalares
include "Normas_3D.idp"
include "../Auxiliary/Macros_3D.idp"

// Cargo las funciones de lectura y guardado
include "IO.idp" 
include "../Auxiliary/search.idp"

/////////////////////////////////////////////////////////////////////////////////////
mpi(cout<< "Cargando la mallas HF y LF"<<endl;)
mesh3 Th = readmesh3("IEfluids.mesh"); //Cargo la malla HF
mesh3 ThLF = readmesh3("IEfluids_LF.mesh"); // Cargo la malla LF
mesh3 ThG = Th, ThLFG = ThLF;


// Malla truncada (HF) para el análisis espectral. Caja x in (1400,1800), y in (100,300), z in (145,345),
// es decir 400x200x200 (el mallado tiene dx=2*dy=2*dz). Estas cotas deben coincidir con las constantes
// de fourier3D_IEFluids_trunc.idp (fase de los modos y wx) y de fourier3D_FFT.idp (caja de muestreo).
mpi(cout<<" - Truncando la malla HF y creando mallas truncadas locales..."<<endl;)
mesh3 ThTrunc = trunc(Th, ((x<1800)),split=1);
ThTrunc = trunc(ThTrunc, ((x>1400)),split=1);
ThTrunc = trunc(ThTrunc, ((y<300)),split=1);
ThTrunc = trunc(ThTrunc, ((y>100)),split=1);
ThTrunc = trunc(ThTrunc, ((z<345)),split=1);
ThTrunc = trunc(ThTrunc, ((z>145)),split=1);

// Dimensiones de la malla total: x,y,z -> [3.8, 2085]x[1.92, 335]x[1, 489] (approx)
mesh3 ThTruncG = ThTrunc; // Malla global (antes de repartirla entre procesos)


// Macros para la malla en paralelo
int[int] myN2o, myN2oLF, myN2oTrunc;
macro ThN2O() myN2o //EOM
macro ThLFN2O() myN2oLF //EOM
macro ThTruncN2O() myN2oTrunc // EOM

buildDmesh(Th);
buildDmesh(ThLF);
buildDmesh(ThTrunc);

/////////////////////////////////////////////////////////////////////////////////////

int ReSnap = 20; // numero de Snapshots de Reynolds
int TimeSnap = 6; // numero de Snapshots en tiempo por cada Reynolds
bool bPETSc = 1; // Para hacer los innerprodX sin hacer antes el changenumbering

/////////////////////////////////////////////////////////////////////////////////////
mpi(cout<< "Creando espacio de elementos finitos..."<<endl;)
macro PkP1() P1 // EOM
macro Pk3P1() [P1,P1,P1] // EOM

// Espacios de elementos finitos (G = malla global, sin G = malla local de cada proceso)
fespace Vh3P1G(ThG, Pk3P1);
fespace Vh3P1(Th, Pk3P1);

fespace Vh3P1LFG(ThLFG, Pk3P1);
fespace Vh3P1LF(ThLF, Pk3P1);

fespace VhP1trunc(ThTrunc, PkP1);

// PETSc matrices
Mat MatNormL2, MatNormLFL2;
int[int] mapVh3P1, mapVh3P1LF;

{
	macro def(i) [i, i#Y, i#Z] //
	macro init(i) [i, i, i] // EOM
	
    createMat(Th, MatNormL2, Pk3P1);
    createMat(ThLF, MatNormLFL2, Pk3P1);   
}

mapVh3P1 = restrict(Vh3P1, Vh3P1G, myN2o);
mapVh3P1LF = restrict(Vh3P1LF, Vh3P1LFG, myN2oLF);

{
	varf NormV([u, uY, uZ],[v, vY, vZ]) = int3d(Th)(UporV(u,v));
    varf NormVLF([u, uY, uZ],[v, vY, vZ]) = int3d(ThLF)(UporV(u,v));
	
	matrix PescV = NormV(Vh3P1, Vh3P1); 
    matrix PescVLF = NormVLF(Vh3P1LF, Vh3P1LF);

	MatNormL2 = PescV;
    MatNormLFL2 = PescVLF;
}


/////////////////////////////////////////////////////////////////////////////////////

mpi(cout<< "Leyendo datos low fidelity y high fidelity (para calcular errores)..."<<endl;)
real[int, int] MBaseVlow(Vh3P1LF.ndof, TimeSnap*ReSnap), MBaseVhigh(Vh3P1.ndof, TimeSnap*ReSnap); 

for (int NRe=1; NRe<=ReSnap; NRe++){
    for (int NTemp=1; NTemp<=TimeSnap; NTemp++){
        int i = NTemp-1;
        mpi(cout << "V_" + NRe + "_meanfile" + NTemp << endl;)
        
        Vh3P1LFG [BaseVLFG,BaseVGLFY,BaseVGLFZ];		
        Vh3P1LF [BaseVLF,BaseVLFY,BaseVLFZ];		

        readvector("SnapshotsLFinterp/V_" + NRe + "_meanfile" + NTemp + ".txt", real, SolGLF, 0); // Estos son los low fidelity obtenidos interpolando los High Fidelity

        BaseVLFG[] = SolGLF;
        BaseVLF[] = BaseVLFG[](mapVh3P1LF); // Load in the local mesh (LF)
        MBaseVlow(:,i+(NRe-1)*TimeSnap) = BaseVLF[];
        
        Vh3P1G [BaseVG,BaseVGY,BaseVGZ];		
        Vh3P1 [BaseV,BaseVY,BaseVZ];		
        readvector("Snapshots/V_" + NRe + "_meanfile" + NTemp + ".txt", real, SolG, 0); // Estos son los HIGH fidelity
        BaseVG[] = SolG;
        BaseV[] = BaseVG[](mapVh3P1); // Load in the local mesh (HF)

        MBaseVhigh(:,i+(NRe-1)*TimeSnap) = BaseV[];

    }
}

/////////////////////////////////////////////////////////////////////////////////////
// Parámetros del Greedy y del estimador espectral

int maxGreedy = 6; // Número máximo de iteraciones del Greedy
int NRe = 1; // Reynolds para la primera iteración
int NbasesV = 1;
real epsPOD = 1e-3; // Tolerancia de la POD (la usa POD.idp)
real[int] MuBest(maxGreedy+1);
MuBest(0) = 1;
real[int] EReynolds(ReSnap);
real[int] EReynolds0(ReSnap); // Para comparar con el Greedy anterior
int kmax = 12; // Máximo índice de modo de Fourier en cada dirección
int kinf = 2; // Rango [kinf,ksup) de coronas (número de onda) usado en el ajuste a k^(-5/3)
int ksup = 12;

include "fourier3D_IEFluids_trunc.idp"; // MProdL2 (partición de la unidad) y energyk3d (agrupación por coronas)
include "fourier3D_FFT.idp"; // espectro3DFFT: espectro por muestreo en rejilla + DFT separable (sin plugins)

real[int, int] MBaseVcomplete(Vh3P1.ndof, TimeSnap*ReSnap); // Snapshots HF de los Reynolds ya elegidos (se amplía en cada iteración)

real[int] ErrorL1L2(maxGreedy), ErrorLinfL2(maxGreedy); // Error L2 relativo HF-ROM por iteración (norma l1 paramétrica normalizada y máximo sobre los Reynolds, a t final), solo para monitorizar

for (int iGreedy=0; iGreedy<maxGreedy; iGreedy++){ // Bucle de la fase OFFLINE
    
    mpi(cout<< "Iteracion "+iGreedy+" del Greedy..."<<endl;)

    real[int, int] MBaseV(Vh3P1.ndof, TimeSnap*(iGreedy+1)); // Se modifica la dimension en cada etapa. Tiene dimension HF ---> la base POD se elige de los HF.

    mpi(cout<< " -- Cargando datos..." <<endl;)
    string Reynolds = NRe;
    for (int NTemp=1; NTemp<=TimeSnap; NTemp++){
        int i = NTemp-1;
        mpi(cout<<"V_"+NRe+"_meanfile"+NTemp<<endl;)
        {
            Vh3P1G [BaseVG,BaseVGY,BaseVGZ];
            Vh3P1 [BaseV, BaseVY, BaseVZ];		
            readvector("Snapshots/V_" + Reynolds + "_meanfile" + NTemp + ".txt", real, SolG, 0);
            BaseVG[] = SolG;
            BaseV[] = BaseVG[](mapVh3P1); // Load in the local mesh
            MBaseVcomplete(:, i+TimeSnap*iGreedy) = BaseV[]; // Se añaden los nuevos snapshots a la base
        }	
    }

    for (int i=0; i<TimeSnap*(iGreedy+1); i++){
	    MBaseV(:,i) = MBaseVcomplete(:,i); // Se cogen los snapshots de la base completa
    }
    
    mpi(cout<< "Hecho." << endl;)

    // Calculo los eigenvalues y eigenvectors 
    mpi(cout<< " - Calculando POD..."<<endl;)
    Vh3P1[int] [BaseV, BaseVY, BaseVZ](TimeSnap*(iGreedy+1)); // Las bases POD son HF -- Pero necesito guardar tambien otras en LF para calcular los coeficientes.
    Vh3P1LF[int] [BaseLFV, BaseLFVY, BaseLFVZ](TimeSnap*(iGreedy+1));
    include "POD.idp" 
    POD(MBaseV, MatNormL2, BaseV, NbasesV, autovalVel);
    mpi(cout << "Terminado con " + NbasesV + " bases" << endl;)
    
	// Guardamos las bases POD de cada iteración del Greedy, así las podemos recuperar cuando queramos
	Vh3P1G[int] [BaseFinalG, BaseFinalGY, BaseFinalGZ](NbasesV);
    real[int, int] MBaseFinalG(Vh3P1G.ndof, NbasesV);
	for(int k=0; k<NbasesV; k++){

        // Interpolo la base POD (HF) a la malla LF para calcular los coeficientes con los snapshots LF
        {
            macro def(i) [i, i#Y, i#Z] // EOM
            macro init(i) [i, i, i] // EOM
            Vh3P1 def(BaseVaux);  BaseVaux[] = BaseV[k][];
            Vh3P1LF def(BaseLFVaux);
		    VecInterpolate(Th, [P1,P1,P1], BaseVaux, ThLF, [P1,P1,P1], BaseLFVaux);
            BaseLFV[k][] = BaseLFVaux[];
        }
		BaseFinalG[k][] = Local2Global(BaseV[k][], BaseFinalG[k][], MatNormL2.D, mapVh3P1);
        MBaseFinalG(:,k) = BaseFinalG[k][]; 	    
    }
    
    // Guardo dos veces la base, una destaca el numero de iter Greedy y otra destaca el numero de bases que hay
	write("BaseMF_Greedy_" + iGreedy + ".txt", MBaseFinalG, 0, 0, 0, 20);
	write("BaseMF_N_" + NbasesV + ".txt", MBaseFinalG, 0, 0, 0, 20);

    /////////////////////////////////////////////////////////////////////////////////////

    // Bucle en el parámetro

    mpi(cout<< "Bucle Multifidelity..."<< endl;)
    EReynolds = 0;

    real[int] ErrorL2(ReSnap);
    for (int NRe=1; NRe<=ReSnap; NRe++){
        mpi(cout<< " -- NRe = "+NRe << endl;)

        // Reconstrucción de la solución en el espacio reducido (último tiempo de cada Reynolds)
        Vh3P1LF [SnapLF, SnapLFY, SnapLFZ];
        Vh3P1 [Snap, SnapY, SnapZ];

        Snap[] = MBaseVhigh(:, TimeSnap*NRe-1);
        SnapLF[] = MBaseVlow(:, TimeSnap*NRe-1);

        // Coeficientes reducidos: proyección del snapshot LF sobre la base POD interpolada a LF
        real[int] coefLF(NbasesV);
        Vh3P1 [uRB, uRBY, uRBZ];
        uRB[] = 0.; // La solución RB es HF, pues es combinación de las funciones de base POD (HF)
        Vh3P1LF [uRBLF, uRBLFY, uRBLFZ];
        for(int j=0; j<NbasesV; j++){
            coefLF(j) = innerprodX(BaseLFV[j][], SnapLF[], MatNormLFL2, bPETSc);
            uRB[] += coefLF(j)*BaseV[j][];
        }
        {
            macro def(i) [i, i#Y, i#Z] //EOM
            macro init(i) [i, i, i] //EOM
            VecInterpolate(Th, [P1,P1,P1], uRB, ThLF, [P1,P1,P1], uRBLF); // uRB en la malla LF (solo para el error LF)
        }

        // Error L2 relativo de la solución reducida respecto a los snapshots (solo para monitorizar)
        Vh3P1 [ErrorPOD, ErrorPODY, ErrorPODZ];
        Vh3P1LF [ErrorPODLF, ErrorPODLFY, ErrorPODLFZ];
        
        ErrorPOD[] = Snap[] - uRB[];
        ErrorPODLF[] = SnapLF[] - uRBLF[];
        
        ErrorL2(NRe-1) = normX(ErrorPOD[], MatNormL2, bPETSc)/normX(Snap[], MatNormL2, bPETSc); // Ya es el error L2 global RELATIVO (de la solucion HF)
        real ErrorL2LF = normX(ErrorPODLF[], MatNormLFL2, bPETSc)/normX(SnapLF[], MatNormLFL2, bPETSc);
        mpi(cout<<" Error L2 relativo = " << ErrorL2(NRe-1) << endl;)
        mpi(cout<<" Error L2 relativo LowF = " << ErrorL2LF<< endl;)
        
        // Espectro de la solución reducida: se interpola a la malla truncada HF
        VhP1trunc uRBTrunc, uRBTruncY, uRBTruncZ;
        uRBTrunc = uRB; uRBTruncY = uRBY; uRBTruncZ = uRBZ;

        mpi(cout<<"Calculamos el espectro de la solucion reducida"<<endl;)
        real[int] espectroIEFluids = espectro3DFFT(uRBTrunc[], uRBTruncY[], uRBTruncZ[], kmax);
        write("EspectrosGreedy/EspectroFFT_Re_" + NRe + "_" + iGreedy + ".txt", espectroIEFluids, 0, 0, 0, 20);

        // Calibración de a por mínimos cuadrados sobre el rango inercial [kinf,ksup):
        // a* = argmin_a sum_i (E_i - a*k_i^p)^2 = sum(E_i*k_i^p) / sum(k_i^(2p))  (solución cerrada)
        real pExp = -5./3.; // Exponente de Kolmogorov (K41)
        int Nk = ksup-kinf;
        real[int] kpow(Nk);
        real numAlpha = 0., denAlpha = 0.;
        for (int i=kinf; i<ksup; i++){
            real ii = i*1.;
            kpow(i-kinf) = pow(ii,pExp);
            numAlpha += espectroIEFluids(i)*kpow(i-kinf);
            denAlpha += kpow(i-kinf)*kpow(i-kinf);
        }
        real a = numAlpha/denAlpha;

        real[int] espectroteorico(Nk); espectroteorico = a*kpow; // reutiliza kpow, sin recalcular pow()
        real[int] diffespectro(Nk); diffespectro = 0.;
        for (int i=kinf; i<ksup; i++){
            diffespectro(i-kinf) = abs(espectroIEFluids(i) - espectroteorico(i-kinf));
        }
        // Estimador (versión relativa): desviación l2 del espectro respecto al ajuste K41, normalizada por la norma l2 del ajuste
        EReynolds(NRe-1) = diffespectro.l2/espectroteorico.l2;
        mpi(cout << " Estimador final de espectros = " << EReynolds << endl;)
    }
    write("Indicador.txt", EReynolds, 1, 0, 0);
    int nuevoRe = EReynolds.imax + 1;

    ErrorL1L2(iGreedy) = ErrorL2.l1/ReSnap; // Media sobre los Reynolds (ErrorL2 ya es global: normX reduce entre procesos)
    ErrorLinfL2(iGreedy) = ErrorL2.max;

    mpi(cout<<"Error maximo relativo"<<ErrorLinfL2<<endl;)

    write("ErrorL1L2.txt", ErrorL1L2, 0, 0 ,0);
    write("ErrorLinfL2.txt", ErrorLinfL2, 0, 0, 0);

    // Criterio del Greedy (Algoritmo 1 del paper): máximo del estimador; si ya estaba elegido,
    // máxima variación del estimador respecto a la iteración anterior entre los no elegidos
    if (search(MuBest,nuevoRe)>=0){
    	real[int] difEstimador(ReSnap); difEstimador = 0.;
    	difEstimador = EReynolds-EReynolds0;
    	difEstimador = abs(difEstimador);
    	while(search(MuBest,difEstimador.imax+1)>=0){
    		// Eliminamos los ya elegidos
    		difEstimador(difEstimador.imax) = 0.;
    	}
    	MuBest(iGreedy+1)= difEstimador.imax + 1;
    }
    else{
    	MuBest(iGreedy+1) = EReynolds.imax + 1;
    }
    mpi(cout<<"Reynolds escogidos"<<MuBest<<endl;)
    NRe = MuBest(iGreedy + 1);
    EReynolds0 = EReynolds; // Estimador de esta iteración, para el criterio de la siguiente
}
