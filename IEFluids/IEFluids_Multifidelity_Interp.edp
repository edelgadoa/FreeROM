///////////////////////////////////////////////////////////////////////////////

// Código para hacer la fase OFFLINE del método multifidelitiy con los datos de IEFluids

load "msh3"
load "gmsh"
load "iovtk"
load "lapack"

verbosity = 0;
int[int] fforder=[1,1,1,1];

load "PETSc"

// Paralelo
macro dimension() 3 //EOM
bool PETScON = true;

include "macro_ddm.idp"


// Cargamos las funciones para pasar la numeracion de IEfluids a FreeFem
// include "IE2FF.idp" // ** ENRIQUE: Esto quizás no es necesario, porque los snapshots ya están guardados en numeracion FF
include "Normas_3D.idp"
include "../Auxiliary/Macros_3D.idp"

// Cargo las funciones de lectura y guardado
include "IO.idp" 
include "../Auxiliary/search.idp"

/////////////////////////////////////////////////////////////////////////////////////
mpi(cout<< "Cargando la mallas HF y LF";)
mesh3 Th = readmesh3("IEfluids.mesh"); //Cargo la malla HF
mesh3 ThLF = readmesh3("IEfluids_LF.mesh"); // Cargo la malla LF
mesh3 ThG = Th, ThLFG = ThLF;


// Creo la malla truncada
mpi(cout<<" - Truncando malla global LF y creando mallas truncadas locales..."<<endl;)
mesh3 ThTruncLF = trunc(ThLFG, ((x<1800)),split=1); 
ThTruncLF = trunc(ThTruncLF, ((x>1400)),split=1); // Probar con 1400 (mismas divisiones) 1600 (cubo perfecto)
ThTruncLF = trunc(ThTruncLF, ((y<300)),split=1); //300 //original 240
ThTruncLF = trunc(ThTruncLF, ((y>100)),split=1); //100 //original 40
ThTruncLF = trunc(ThTruncLF, ((z<345)),split=1); //345 //original 350
ThTruncLF = trunc(ThTruncLF, ((z>145)),split=1); //145 //original 150

//Dimensiones de la malla total: x,y,z -> [3.8, 2085]x[1.92, 335]x[1, 489] (approx)
mesh3 ThTruncLFG = ThTruncLF; // For the global mesh


// Macros para la malla en paralelo
int[int] myN2o, myN2oLF, myN2oTruncLF;
macro ThN2O() myN2o //EOM
macro ThLFN2O() myN2oLF //EOM
macro ThTruncLFN2O() myN2oTruncLF // EOM

buildDmesh(Th);
buildDmesh(ThLF);
buildDmesh(ThTruncLF);


/////////////////////////////////////////////////////////////////////////////////////


int ReSnap = 20; // numero de Snapshots de Reynolds
int TimeSnap = 6; // numero de Snapshots en tiempo por cada Reynolds
int Nsnap = ReSnap*TimeSnap;
bool bPETSc = 1; // Para hacer los innerprodX sin hacer antes el changenumbering

/////////////////////////////////////////////////////////////////////////////////////
mpi(cout<< "Creando espacio de elementos finitos..."<<endl;)
macro Pk3P1() [P1,P1,P1] // EOM

// Variables donde guardo los snapshots que cargo

fespace Vh3P1G(ThG, Pk3P1);
fespace Vh3P1(Th, Pk3P1);

fespace Vh3P1LFG(ThLFG, Pk3P1);
fespace Vh3P1LF(ThLF, Pk3P1);

fespace Vh3P1truncLF(ThTruncLF, Pk3P1);  
fespace Vh3P1truncLFG(ThTruncLFG, Pk3P1);

matrix MinterpHF2LF = interpolate(Vh3P1LF, Vh3P1);

// PETSc matrices
Mat MatNormL2, MatNormLFL2;
int[int] mapVh3P1trunc, mapVh3P1, mapVh3P1LF; 

{
	macro def(i) [i, iY, iZ] //
	macro init(i) [i, i, i] // EOM
	
    createMat(Th, MatNormL2, Pk3P1);
    createMat(ThLF, MatNormLFL2, Pk3P1);   
}

mapVh3P1 = restrict(Vh3P1, Vh3P1G, myN2o);
mapVh3P1LF = restrict(Vh3P1LF, Vh3P1LFG, myN2oLF);
mapVh3P1trunc = restrict(Vh3P1truncLF, Vh3P1truncLFG, myN2oTruncLF);

{
	varf NormV([u, uY, uZ],[v, vY, vZ]) = int3d(Th)(UporV(u,v));
    varf NormVLF([u, uY, uZ],[v, vY, vZ]) = int3d(ThLF)(UporV(u,v));
	
	matrix PescV = NormV(Vh3P1, Vh3P1); 
    matrix PescVLF = NormVLF(Vh3P1LF, Vh3P1LF);

	MatNormL2 = PescV;
    MatNormLFL2 = PescVLF;
}


/////////////////////////////////////////////////////////////////////////////////////

mpi(cout<< "Leyendo datos low fidelity..."<<endl;)
real[int, int] MBaseVlow(Vh3P1LF.ndof, TimeSnap*ReSnap); 

for (int NRe=1; NRe<=ReSnap; NRe++){
    for (int NTemp=1; NTemp<=TimeSnap; NTemp++){
        int i = NTemp-1;
        mpi(cout << "V_" + NRe + "_meanfile" + NTemp << endl;)
        
        Vh3P1LFG [BaseVG,BaseVGY,BaseVGZ];		
        Vh3P1LF [BaseV,BaseVY,BaseVZ];		
        readvector("SnapshotsLFinterp/V_" + NRe + "_meanfile" + NTemp + ".txt", real, SolG, 0); // Estos son los low fidelity obtenidos interpolando los High Fidelity
        BaseVG[] = SolG;
        BaseV[] = BaseVG[](mapVh3P1LF); // Load in the local mesh (LF)
  
        MBaseVlow(:,i+(NRe-1)*TimeSnap) = BaseV[];
    }
}

/////////////////////////////////////////////////////////////////////////////////////

int maxGreedy = 6; // Número máximo de iteraciones del Greedy
int NRe = 1; // Reynolds para la primera iteración
int NbasesV = 1; 
real epsPOD = 1e-3;
real[int] MuBest(maxGreedy+1);
MuBest(0) = 1;
real[int] ETiempo(6);
real[int] EReynolds(ReSnap);
real[int] EReynolds0(ReSnap); // Para comparar con el Greedy anterior
real[int] EGreedy(maxGreedy);
int kmax = 24; // ** Comprobar
int kinf = 5; // ** Comprobar
int ksup = kmax; // ** Comprobar

include "fourier3D_IEFluids_trunc.idp"; // Funciones para calcular la transformada de fourier

real[int, int] MBaseVcomplete(Vh3P1.ndof, TimeSnap*ReSnap); // Se modifica la dimension en cada etapa

real[int] ErrorL1L2(maxGreedy), ErrorLinfL2(maxGreedy); // Para calcular los errores POD en el Greedy
real[int] ErrorL1L2G(maxGreedy), ErrorLinfL2G(maxGreedy); // Lo mismo pero en Global

for (int iGreedy=0; iGreedy<maxGreedy; iGreedy++){ // Bucle de la fase OFFLINE
    
    mpi(cout<< "Iteracion "+iGreedy+" del Greedy..."<<endl;)

    real[int, int] MBaseV(Vh3P1.ndof, TimeSnap*(iGreedy+1)); // Se modifica la dimension en cada etapa. Tiene dimension HF ---> la base POD se elige de los HF.

    mpi(cout<< " -- Cargando datos..." <<endl;)
    string Reynolds = NRe;
    for (int NTemp=1; NTemp<=TimeSnap; NTemp++){
        int i = NTemp-1;
        mpi(cout<<"V_"+NRe+"_meanfile"+NTemp<<endl;)
        {
            Vh3P1G [BaseVG,BaseVGY,BaseVGZ];
            Vh3P1 [BaseV, BaseVY, BaseVZ];		
            readvector("Snapshots/V_" + Reynolds + "_meanfile" + NTemp + ".txt", real, SolG, 0);
            BaseVG[] = SolG;
            BaseV[] = BaseVG[](mapVh3P1); // Load in the local mesh
            MBaseVcomplete(:, i+TimeSnap*iGreedy) = BaseV[]; // Se añaden los nuevos snapshots a la base
        }	
    }

    for (int i=0; i<TimeSnap*(iGreedy+1); i++){
	    MBaseV(:,i) = MBaseVcomplete(:,i); // Se cogen los snapshots de la base completa
    }
    
    mpi(cout<< "Hecho." << endl;)

    // Calculo los eigenvalues y eigenvectors 
    mpi(cout<< " - Calculando POD..."<<endl;)
    Vh3P1[int] [BaseV, BaseVY, BaseVZ](TimeSnap*(iGreedy+1)); // Las bases POD son HF -- Pero necesito guardar tambien otras en LF para calcular los coeficientes.
    Vh3P1LF[int] [BaseLFV, BaseLFVY, BaseLFVZ](TimeSnap*(iGreedy+1));
    include "POD.idp" 
    POD(MBaseV, MatNormL2, BaseV, NbasesV, autovalVel);
    mpi(cout << "Terminado con " + NbasesV + " bases" << endl;)
    
	// Guardamos las bases POD de cada iteración del Greedy, así las podemos recuperar cuando queramos
	Vh3P1G[int] [BaseFinalG, BaseFinalGY, BaseFinalGZ](NbasesV);
    real[int, int] MBaseFinalG(Vh3P1G.ndof, NbasesV);
	for(int k=0; k<NbasesV; k++){
        BaseLFV[k][] = MinterpHF2LF*BaseV[k][]; // Interpolo la base POD en la malla LF para el calculo de los coef. POD.
		BaseFinalG[k][] = Local2Global(BaseV[k][], BaseFinalG[k][], MatNormL2.D, mapVh3P1);
        MBaseFinalG(:,k) = BaseFinalG[k][]; 	    
    }
    
    // Guardo dos veces la base, una destaca el numero de iter Greedy y otra destaca el numero de bases que hay
	write("BasePOD_Greedy_" + iGreedy + ".txt", MBaseFinalG, 0, 0, 0, 20);
	write("BasePOD_N_" + NbasesV + ".txt", MBaseFinalG, 0, 0, 0, 20);

    /////////////////////////////////////////////////////////////////////////////////////

    // Bucle en el parámetro

    mpi(cout<< "Bucle Multifidelity..."<< endl;)
    EReynolds = 0;

    real[int] ErrorL2(ReSnap);
    for (int NRe=1; NRe<=ReSnap; NRe++){
        mpi(cout<< " -- NRe = "+NRe << endl;)

        // Reconstrucción de la solución en el espacio reducido.
        
        ETiempo = 0;
        
        // for (int NTemp=1; NTemp<=TimeSnap; NTemp++){ 
            // Leo en cada tiempo
            Vh3P1 [Snap, SnapY, SnapZ];
            
            Snap[] = MBaseVcomplete(:, TimeSnap*NRe-1); // Tomo el último tiempo de cada Reynolds

            [SnapTrunc, SnapTruncY, SnapTruncZ] = [Snap, SnapY, SnapZ]; // Tomo los truncados porque será lo que use el estimador
            
            // Hallo los coeficientes reducidos (very)low-fidelity y construyo solucion reducida
            real[int] coefLF(NbasesV); // Lo dejo así por si queremos guardar los coeficientes en algún momento
            Vh3P1 [uRB, uRBY, uRBZ]; uRB[]=0.; //La solucion RB tiene que ser HF, pues es combinacion de las funciones de base POD (HF)
            Vh3P1LF [uRBLF, uRBLFY, uRBLFZ]; //Tengo que obtener su interpolacion a LF para hallar el Kolmogorov
            for(int j=0; j<NbasesV; j++){               
                coefLF(j) = innerprodX(BaseLFV[j][], Snap[], MatNormLFL2, bPETSc); 
                uRB[] += coefLF(j)*BaseV[j][];
                uRBFL[] = MinterpHF2LF*uRB[];
            }

            // Calculo el error L2 de la solucion para cada Reynols
            Vh3P1 [ErrorPOD, ErrorPODY, ErrorPODZ];
            ErrorPOD[] = Snap[] - uRB[];
            
            ErrorL2(NRe-1) = normX(ErrorPOD[], MatNormL2, bPETSc)/normX(Snap[], MatNormL2, bPETSc); // Ya es el error L2 global RELATIVO (de la solucion HF)
            mpi(cout<<" Error L2 relativo = " << ErrorL2(NRe-1) << endl;)
            
            // Cálculo del espectro de la solución reducida -> Hay que truncar la solucion
            VhP1truncLF uRBTrunc, uRBTruncY, uRBTruncZ;
            uRBTrunc = uRBLF; uRBTruncLFY = uRBY; uRBTruncZ = uRBLFZ; 
            
                        
            mpi(cout<<"Calculamos el espectro de la solucion reducida"<<endl;)
            real[int] espectroIEFluids = espectro3D(uRBTruncLF[], uRBTruncLFY[], uRBTruncLFZ[], kmax); //
                     
            write("EspectrosGreedy/EspectroLF_Re_" + NRe + "_" + iGreedy + ".txt", espectroIEFluids, 0, 0, 0, 20);
            
            real kmed = (ksup-kinf)/2;
            real a = espectroIEFluids(kmed)/pow(kmed,-5/3); // Un valor de referencia para el espectro teórico
            //mpi(cout<<"a= "<<a<<endl;)
            real[int] diffespectro(ksup-kinf); diffespectro = 0.;
            real[int] espectroteorico(ksup-kinf); espectroteorico = 0.;
            for (int i=kinf; i<ksup; i++){
                real ii = i*1.;
                espectroteorico(i-kinf) = a*pow(ii,-5/3);
                diffespectro(i-kinf) = abs(espectroIEFluids(i) - a*pow(ii,-5/3));
            }
            //mpi(cout<<"diffespectro: "<<diffespectro<<endl;)
            //mpi(cout<<"espectro teorico: "<<espectroteorico<<endl;)
            // ETiempo(NTemp-1) = diffespectro.l2/espectroteorico.l2 ;
            // mpi(cout<<"ETiempo = "<<ETiempo<<endl;)
         
             // Es la versión relativa del indicador
            /*
            // Calculo el error relativo en tiempo
            Vh3P1 [eRB,eRBY,eRBZ]; 
            eRB[] = Snap[] - uRB[]; 
            real erabstime = sqrt((innerprodX(eRB[], eRB[], MatNormV, bPETSc))); // error absoluto
            ETiempo(NTemp-1) = erabstime/sqrt(innerprodX(Snap[], Snap[], MatNormV, bPETSc)); // error relativo
            */

       // }
        
        EReynolds(NRe-1) = diffespectro.l2/espectroteorico.l2 ; //ETiempo.max; // ** Preguntar a Tomás si esto es correcto
        mpi(cout << " Estimador final de espectros = " << EReynolds << endl;)
				
    }
    write("Indicador.txt", EReynolds, 1, 0, 0);
    int nuevoRe = EReynolds.imax + 1;

    ErrorL1L2(iGreedy) = ErrorL2.l1; // En la línea 269 indicas que es el error global relativo, aquí los estas sumando por el número de procesadores
    ErrorLinfL2(iGreedy) = ErrorL2.max;

    mpi(cout<<"Error maximo relativo"<<ErrorLinfL2<<endl;)

    write("ErrorL1L2.txt", ErrorL1L2G, 0, 0 ,0);
    write("ErrorL1Linf.txt", ErrorLinfL2G, 0, 0, 0);

    // Modificacion del criterio del Greedy
    if (search(MuBest,nuevoRe)>=0){ // Si vamos a seleccionar uno ya seleccionado

    	// Se haya la diferencia de los espectros
    	real[int] difEstimador(ReSnap); difEstimador = 0.;
    	difEstimador = EReynolds-EReynolds0;
    	difEstimador = abs(difEstimador);
    	while(search(MuBest,difEstimador.imax+1)>=0){
    		// Eliminamos los ya elegidos
    		difEstimador(difEstimador.imax) = 0.;
    	}
    	// Escogemos el valor para la mayor diferencia
    	EGreedy(iGreedy) = difEstimador.max;
    	MuBest(iGreedy+1)= difEstimador.imax + 1;
    }
    else{
    	EGreedy(iGreedy) = EReynolds.max;
    	MuBest(iGreedy+1) = EReynolds.imax + 1;
    }
    mpi(cout<<"Reynolds escogidos"<<MuBest<<endl;)
    // Actualizo el valor del espectro anterior
    NRe = MuBest(iGreedy + 1);
    EReynolds0 = EReynolds;
}