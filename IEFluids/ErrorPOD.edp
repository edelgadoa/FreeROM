///////////////////////////////////////////////////////////////////////////////

// Código para calcular errores POD del método multifidelitiy con los datos de IEFluids

load "msh3"
load "gmsh"
load "iovtk"
load "lapack"

verbosity = 0;
int[int] fforder=[1,1,1,1];

load "PETSc"

// Paralelo
macro dimension() 3 //EOM
bool PETScON = true;

include "macro_ddm.idp"

include "Normas_3D.idp"
include "../Auxiliary/Macros_3D.idp"

// Cargo las funciones de lectura y guardado
include "IO.idp" 
include "../Auxiliary/search.idp"

/////////////////////////////////////////////////////////////////////////////////////
mpi(cout<< "Cargando la malla...";)
mesh3 Th = readmesh3("IEfluids.mesh"); //Cargo la malla
mesh3 ThG = Th;

// Macros para la malla en paralelo
int[int] myN2o,myN2oTrunc;
macro ThN2O() myN2o //EOM

buildDmesh(Th);

/////////////////////////////////////////////////////////////////////////////////////

mpi(cout<< "Parametros del problema...";)
int ReSnap = 20; // numero de Snapshots de Reynolds
int TimeSnap = 6; // numero de Snapshots en tiempo por cada Reynolds
int Nsnap = ReSnap*TimeSnap;
bool bPETSc = 1; // Para hacer los innerprodX sin hacer antes el changenumbering

int NGreedyMAX = 6; // Numero de iteraciones greedy -> N=0,1,2,3,4,5.

/////////////////////////////////////////////////////////////////////////////////////

macro Pk3P1() [P1,P1,P1] // EOM
macro PkP1() P1 // EOM // No sé si este es necesario

// Espacio de Elementos Finitos
fespace VhP1G(ThG, P1); //*No lo uso de momento

fespace Vh3P1G(ThG, Pk3P1);
fespace Vh3P1(Th, Pk3P1);


// PETSc matrices
Mat MatNormL2;
int[int] mapVh3P1; 

{
	macro def(i) [i, iY, iZ] //
	macro init(i) [i, i, i] // EOM
	createMat(Th, MatNormL2, Pk3P1);   
}

mapVh3P1 = restrict(Vh3P1, Vh3P1G, myN2o);

// Matriz de Producto Escalar L2
{
	varf NormV([u, uY, uZ],[v, vY, vZ]) = int3d(Th)(UporV(u,v));
	
	matrix PescV = NormV(Vh3P1, Vh3P1); //L2PEMat;
	MatNormL2 = PescV;
}

/////////////////////////////////////////////////////////////////////////////////////
// Leo los Snapshots

real[int, int] MBaseV(Vh3P1.ndof, ReSnap); 

for (int NRe=1; NRe<=ReSnap; NRe++){
    string Reynolds = NRe;
    // mpi(cout << "V_" + NRe + "_meanfile" + NTemp << endl;)
        
    Vh3P1G [BaseVG,BaseVGY,BaseVGZ];		
    Vh3P1 [BaseV,BaseVY,BaseVZ];		
    readvector("Snapshots/V_" + Reynolds + "_meanfile" + 6 + ".txt", real, SolG, 0); //Cargo solo los tiempos finales
    BaseVG[] = SolG;
    BaseV[] = BaseVG[](mapVh3P1); // Load in the local mesh
  
    MBaseV(:, NRe-1) = BaseV[];
}


/////////////////////////////////////////////////////////////////////////////////////

real[int] ErrorL1L2(NGreedyMAX);
real[int] ErrorLinfL2(NGreedyMAX);

for (int iGreedy=0; iGreedy<NGreedyMAX; iGreedy++){ // Bucle de las iteraciones Greedy
    
    // Cargo la base POD correspondiente a cada iteración Greedy
    readmatrix("BasePOD_Greedy_" + iGreedy + ".txt", real, MBasePODG, 0); //Estas bases están en Global, hay que pasarlas a Local
    int NBasesPOD = MBasePODG.m; 
	real[int,int] MBasePOD(Vh3P1.ndof, NBasesPOD); 
	for(int iPOD=0; iPOD<NBasesPOD; iPOD++){
	    Vh3P1G [BasePODG, BasePODGY, BasePODGZ];
		Vh3P1 [BasePOD, BasePODY, BasePODZ];
		BasePODG[] = MBasePODG(:,iPOD);
		BasePOD[] = BasePODG[](mapVh3P1);
		MBasePOD(:,iPOD) = BasePOD[];
	}
	
	
    Vh3P1[int] [uRB, uRBY, uRBZ](ReSnap);
    
    // Calculo los coeficientes POD y reconstruyo la solución POD para cada valor del parámetro 
    for (int iRe = 0; iRe<ReSnap; iRe++){
    	Vh3P1 [Snap, SnapY, SnapZ] = MBaseV(:,iRe);
		real[int] alpha(NBasesPOD);
		for(int iPOD=0; iPOD<NBasesPOD; iPOD++){
			Vh3P1 [BasePOD, BasePODY, BasePODZ];
			BasePOD[] = MBasePOD(:,iPOD);
			alpha(iPOD) = innerprodX(Snap[], BasePOD[], MatNormL2, PETScON); // Lo hago así porque lo tengo más fácil. Se podría pensar en crear un innerprodX que lo haga directo 
		}
    	mpi(cout<<alpha<<endl;)
    }
}
